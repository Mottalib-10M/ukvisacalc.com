---
/**
 * A page of `src/content/pages/`: H1, one-line answer, the simulator in the first screen, the folded
 * citable answer, then the text. A body may carry a second simulator with `h.tool(...)`, rendered as
 * an island marked data-simulateur-secondaire. FAQ, related pages, sources, publisher: PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './tools/Tool';
import { route, ROUTES } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/pages';
import { helpers, SOURCES } from '../lib/helpers';
import { KIT } from '../lib/kit';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef, ToolSpec } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const group = GROUPS.find((g) => g.id === page.group)!;
const parts = page.body(helpers()).split(/<!--tool:([A-Za-z0-9+/=]+)-->/);
const decode = (b: string) => JSON.parse(Buffer.from(b, 'base64').toString('utf8')) as ToolSpec;
const jsonLd = [webApplicationSchema({ name: page.h1, description: page.description, path, lang }), articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id) && id !== page.id).map((id) => ({ href: route(id, lang), name: label(id), description: pageById(id)?.card ?? '' }));
const sources = page.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const sp = KIT.SPONSORS;
const sponsorMeta = { routes: sp.routes, ratings: sp.ratings, date: sp.date, organisations: sp.organisations };
const r = (id: string) => (ROUTES.some((x) => x.id === id) ? route(id, lang) : undefined);
const links = { cost: r('uk-visa-cost-calculator') ?? '', rates: r('skilled-worker-going-rates') ?? '' };
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: group.label }, { label: page.nav }]}>
  <article>
    <header class="mb-4">
      <h1 class="font-serif text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{page.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{page.intro}</p>
    </header>
    <div data-outil data-chrome class="mb-4">
      <Tool client:load {...page.tool} sponsorMeta={page.tool.kind === 'sponsor' ? sponsorMeta : undefined} links={links} uid="t1" />
    </div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a> · Home Office fees of {KIT.date(KIT.FEE_DATE)}, rules checked {KIT.date(KIT.P.retrieved_at)}</p>
    <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-8" />
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p ?? ''} /> : <div data-simulateur-secondaire data-chrome class="not-prose my-8"><Tool client:visible {...decode(p)} sponsorMeta={sponsorMeta} links={links} uid={`t${i + 1}`} /></div>)}
    </div>
  </article>
</PageLayout>
