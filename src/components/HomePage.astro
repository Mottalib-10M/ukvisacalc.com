---
/**
 * Home, in its own order for this subject: four calculators behind tabs (first screen), the folded
 * answer, the fee table of 8 October 2026 for the main routes, the 2026 changes as a dated timeline,
 * the calculators by need, the long text in accordions, then the questions. Text: src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import HomeTools from './tools/HomeTools';
import { HOME } from '../content/home';
import { route, ROUTES } from '../i18n/routes';
import { GROUPS, inGroup } from '../i18n/nav';
import { helpers, SOURCES, table } from '../lib/helpers';
import { KIT } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const sections = x.sections(h);
const r = (id: string) => (ROUTES.some((y) => y.id === id) ? route(id, lang) : '');
const links = { cost: r('uk-visa-cost-calculator'), rates: r('skilled-worker-going-rates') };
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="font-serif text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-1 text-xs text-navy-600 sm:text-sm">Home Office fee table of <time datetime={KIT.FEE_DATE}>{KIT.date(KIT.FEE_DATE)}</time> · rules checked <time datetime={KIT.P.retrieved_at}>{KIT.date(KIT.P.retrieved_at)}</time> · sponsor register of {KIT.date(KIT.SPONSORS.date)} · <a href={route('method', lang)} class="underline">How we calculate</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  </header>
  <div data-outil data-chrome><HomeTools client:load links={links} /></div>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="prose prose-slate max-w-none prose-headings:font-serif">
    <h2>{x.feesTitle}</h2>
    <Fragment set:html={x.feesIntro(h)} />
    <figure class="not-prose"><Fragment set:html={table(['Application', 'Fee', 'Health surcharge', 'Total, one adult'], x.feeRows(h), undefined, ['l', 'r', 'r', 'r'])} /><figcaption class="mt-1 text-sm text-navy-700">{x.feesCaption(h)}</figcaption></figure>
  </section>
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">{x.timelineTitle}</h2>
    <ol class="mt-4 border-l-2 border-accent-500 pl-5">
      {x.timeline(h).map((e) => <li class="mb-4"><p class="text-sm font-semibold text-accent-700"><time datetime={e.date}>{KIT.date(e.date)}</time></p><p class="text-navy-800" set:html={e.text} /></li>)}
    </ol>
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="font-serif text-2xl font-bold text-navy-900">Calculators by need</h2>
    <div class="mt-4 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {GROUPS.map((g) => (<div><h3 class="font-serif text-lg font-bold text-navy-900">{g.label}</h3><ul class="mt-2 space-y-1.5 text-sm">{inGroup(g.id, lang).map((l) => <li><a href={l.href} class="text-accent-700 underline-offset-2 hover:underline">{l.label}</a></li>)}</ul></div>))}
    </div>
  </section>
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {sections.map((s) => <details class="fold"><summary><span class="fold-h">{s.title}</span></summary><div class="prose prose-slate max-w-none pb-4"><Fragment set:html={s.html} /></div></details>)}
  </section>
</PageLayout>
