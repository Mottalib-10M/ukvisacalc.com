---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of Tide Day about a station, a tide time that looks wrong, a missing beach or embedding a tide chart. We answer data questions, not navigation ones.';
---
<PageLayout title="Contact Tide Day: stations, corrections and embedding a tide chart" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>E-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no account: write to us like you would to a harbor office.</p>
    <h2>Useful messages</h2>
    <ul>
      <li>A tide time that does not match the NOAA prediction for the same station and day: tell us the page and the date, we compare it with the NOAA download.</li>
      <li>A beach, inlet or harbor you would like to see: name the place and, if you know it, the NOAA station number.</li>
      <li>Embedding the tide chart on a marina, club or rental site: start with the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot answer</h2>
    <p>We cannot tell you whether a passage, a bar or a channel is safe to cross: that depends on the boat, the weather and local knowledge, and predictions are not observations. Ask the harbormaster, the Coast Guard or a local captain. The <a href={route('method', lang)}>method page</a> explains what the figures can and cannot know.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
