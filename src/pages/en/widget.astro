---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/tide-chart/" title="Tide chart and tide times, US stations" width="100%" height="1150" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed a free tide chart on your marina, club or rental site" description="Embed Tide Day's tide chart on your own site for free with one iframe line: any of 92 US stations, today and 7 days, solunar times. No cookie, no tracking, credit link kept." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed a tide chart', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a tide chart' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed a tide chart</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the predictions are downloaded again, the embedded chart follows on its own.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Useful for marinas, fishing clubs, vacation rentals, surf schools and local news sites. Terms: keep the credit link under the chart visible, do not alter the frame, and do not present it as a navigation tool. The frame sets no cookie and sends nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/tide-chart/" title="Tide chart and tide times, US stations" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
