---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/visa-cost/" title="UK visa cost calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free UK visa cost calculator on your own website" description="Put UK VisaCalc's UK visa cost calculator on your site with one iframe line: fees and health surcharge for a family, updated with each Home Office fee table. No cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the cost calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the cost calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the UK visa cost calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the Home Office publishes a new fee table, the embedded calculator follows on its own.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>For universities, employers, relocation teams and community organisations. Terms: keep the credit line under the calculator visible, do not alter the frame, and do not present it as advice or as an official Home Office tool. The frame sets no cookie and sends nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/visa-cost/" title="UK visa cost calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
