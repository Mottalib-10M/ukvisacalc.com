---
/** Every page of src/content/pages/. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES, slugOf } from '../../lib/pages';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: slugOf(page) }, props: { page } })); }
const { page } = Astro.props;
---
<ContentPage page={page} />
