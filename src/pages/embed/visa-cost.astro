---
/** Embeddable page (iframe): the cost calculator alone. noindex, outside the sitemap (astro.config). */
import '../../styles/global.css';
import CostTool from '../../components/tools/CostTool';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UK visa cost calculator (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/uk-visa-cost-calculator/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><CostTool client:load id="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · Home Office fee table · not legal advice, not affiliated with the Home Office</p>
  </body>
</html>
